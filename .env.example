# Copy this file to .env and fill in the real values.
# .env is gitignored -- never commit it, never paste these values into a chat.

# --- Mailcow IMAP ---
MAILCOW_HOST=mailcow.askcruz.com
MAILCOW_PORT=993
MAILCOW_USERNAME=ayan@askcruz.com
MAILCOW_PASSWORD=
# Folders to harvest. Junk/Trash/Drafts are intentionally left out.
MAILCOW_FOLDERS=INBOX,Sent,Archive

# --- Postgres ---
# If you're reaching the Cruz VPS Postgres, it only listens on 127.0.0.1 there --
# open an SSH tunnel first and point DB_HOST/DB_PORT at the local end:
#   ssh -L 5433:127.0.0.1:5432 deploy@5.223.44.95 -N
# ON THE VPS the service talks to a local Postgres: DB_HOST=127.0.0.1, DB_PORT=5432.
# FROM A LAPTOP you must tunnel first (see above) and use DB_PORT=5433 instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eoxs_wiki_staging
DB_USER=
DB_PASSWORD=
