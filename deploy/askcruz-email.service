[Unit]
Description=AskCruz Mailcow -> Postgres email harvester
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/askcruz-email-harvester
EnvironmentFile=/home/deploy/askcruz-email-harvester/.env
ExecStart=/home/deploy/askcruz-email-harvester/.venv/bin/python3 fetch_and_store.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=askcruz-email
